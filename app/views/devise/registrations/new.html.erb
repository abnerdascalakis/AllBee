<%= render "devise/shared/glass_styles" %>

<div class="container py-5 min-vh-100 d-flex justify-content-center align-items-center">
  <div class="w-100 d-flex justify-content-center" style="max-width: 100%;">
    <div class="w-100" style="max-width: 440px;">
      <div class="card devise-glass-card border-0 shadow-lg text-white overflow-hidden">
        <div class="card-body p-4">
          <div class="mx-auto p-2 p-md-3" style="max-width: 340px;">
        <h1 class="display-6 fw-bold text-center mb-2" style="color: rgba(255, 255, 255, 0.96);">Cadastro</h1>
        <p class="text-center mb-4 fw-medium" style="color: rgba(255, 255, 255, 0.96);">Preencha os dados para criar sua conta.</p>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "needs-validation" }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="mb-4">
            <%= f.label :email, "Email", class: "form-label fw-semibold fs-5" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control form-control-lg text-white px-0 devise-contrast-input", placeholder: "exemplo@gmail.com" %>
          </div>

          <div class="mb-4">
            <%= f.label :password, "Senha", class: "form-label fw-semibold fs-5" %>
            <% if @minimum_password_length %>
              <p class="small mb-2" style="color: rgba(255, 255, 255, 0.9);">Use pelo menos <%= @minimum_password_length %> caracteres.</p>
            <% end %>
            <%= f.password_field :password, autocomplete: "new-password", class: "form-control form-control-lg text-white px-0 devise-contrast-input", placeholder: "Crie uma senha segura" %>
          </div>

          <div class="mb-4">
            <%= f.label :password_confirmation, "Confirmar senha", class: "form-label fw-semibold fs-5" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control form-control-lg text-white px-0 devise-contrast-input", placeholder: "Repita sua senha" %>
          </div>

          <div class="d-grid mt-4 mb-3">
            <%= f.submit "Criar conta", class: "btn btn-light btn-lg fw-bold text-dark border-0", style: "border-radius: 999px;" %>
          </div>
        <% end %>

        <div class="text-center">
          <p class="mb-0 fs-5" style="color: rgba(255, 255, 255, 0.96);">
            Ja possui cadastro?
            <%= link_to "Entrar", new_session_path(resource_name), class: "fw-bold text-white text-decoration-none" %>
          </p>
        </div>

        <div class="mt-3 pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.2) !important;">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
    </div>
  </div>
</div>
