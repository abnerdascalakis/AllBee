<div class="d-grid gap-2">
  <%- if controller_name != "sessions" %>
    <%= link_to "Entrar na conta", new_session_path(resource_name), class: "btn btn-outline-light btn-sm fw-semibold" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != "registrations" %>
    <%= link_to "Criar conta", new_registration_path(resource_name), class: "btn btn-outline-light btn-sm fw-semibold" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <%= link_to "Recuperar senha", new_password_path(resource_name), class: "btn btn-outline-light btn-sm fw-semibold" %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != "confirmations" %>
    <%= link_to "Reenviar confirmacao", new_confirmation_path(resource_name), class: "btn btn-outline-light btn-sm fw-semibold" %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != "unlocks" %>
    <%= link_to "Reenviar desbloqueio", new_unlock_path(resource_name), class: "btn btn-outline-light btn-sm fw-semibold" %>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "Entrar com #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), class: "btn btn-outline-light btn-sm fw-semibold", data: { turbo: false } %>
    <% end %>
  <% end %>
</div>
