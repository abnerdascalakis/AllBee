<%= render "devise/shared/glass_styles" %>

<div class="container py-5 min-vh-100 d-flex justify-content-center align-items-center">
  <div class="w-100 d-flex justify-content-center" style="max-width: 100%;">
    <div class="w-100" style="max-width: 430px;">
      <div class="card devise-glass-card border-0 shadow-lg text-white overflow-hidden">
        <div class="card-body p-4">
          <div class="mx-auto p-2 p-md-3" style="max-width: 330px;">
        <h1 class="display-6 fw-bold text-center mb-2" style="color: rgba(255, 255, 255, 0.96);">Nova senha</h1>
        <p class="text-center mb-4 fw-medium" style="color: rgba(255, 255, 255, 0.96);">Escolha uma nova senha e confirme.</p>

        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "needs-validation" }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>
          <%= f.hidden_field :reset_password_token %>

          <div class="mb-4">
            <%= f.label :password, "Nova senha", class: "form-label fw-semibold fs-5" %>
            <% if @minimum_password_length %>
              <p class="small mb-2" style="color: rgba(255, 255, 255, 0.9);">Use pelo menos <%= @minimum_password_length %> caracteres.</p>
            <% end %>
            <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control form-control-lg text-white px-0 devise-contrast-input", placeholder: "Crie sua nova senha" %>
          </div>

          <div class="mb-4">
            <%= f.label :password_confirmation, "Confirmar nova senha", class: "form-label fw-semibold fs-5" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control form-control-lg text-white px-0 devise-contrast-input", placeholder: "Repita a nova senha" %>
          </div>

          <div class="d-grid mt-4 mb-3">
            <%= f.submit "Salvar nova senha", class: "btn btn-light btn-lg fw-bold text-dark border-0", style: "border-radius: 999px;" %>
          </div>
        <% end %>

        <div class="mt-3 pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.2) !important;">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
    </div>
  </div>
</div>
