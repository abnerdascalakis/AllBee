<%= render "devise/shared/glass_styles" %>

<div class="container py-5 min-vh-100 d-flex justify-content-center align-items-center">
  <div class="w-100 d-flex justify-content-center" style="max-width: 100%;">
    <div class="w-100" style="max-width: 420px;">
      <div class="card devise-glass-card border-0 shadow-lg text-white overflow-hidden">
        <div class="card-body p-4">
          <div class="mx-auto p-2 p-md-3" style="max-width: 320px;">
          <h1 class="display-5 fw-bold text-center mb-2" style="color: rgba(255, 255, 255, 0.96);">Entrar</h1>
          <p class="text-center mb-4 fw-medium" style="color: rgba(255, 255, 255, 0.96);">Acesse sua conta com rapidez e sem distrações.</p>

          <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "needs-validation" }) do |f| %>
            <% if flash[:alert].present? %>
              <div class="alert alert-danger mb-4" role="alert">
                <%= flash[:alert] %>
              </div>
            <% end %>

            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="mb-4">
              <%= f.label :email, "Email", class: "form-label fw-semibold fs-5" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control form-control-lg text-white px-0 devise-contrast-input", placeholder: "exemplo@gmail.com" %>
            </div>

            <div class="mb-4">
              <%= f.label :password, "Senha", class: "form-label fw-semibold fs-5" %>
              <%= f.password_field :password, autocomplete: "current-password", class: "form-control form-control-lg text-white px-0 devise-contrast-input", placeholder: "Digite sua senha" %>
            </div>

            <div class="d-grid mt-4 mb-3">
              <%= f.submit "Entrar", class: "btn btn-light btn-lg fw-bold text-dark border-0", style: "border-radius: 999px;" %>
            </div>
          <% end %>

          <div class="text-center">
            <% if devise_mapping.recoverable? %>
              <p class="mb-3 fs-5" style="color: rgba(255, 255, 255, 0.96);">
                <%= link_to "Esqueci a senha", new_password_path(resource_name), class: "fw-semibold text-white text-decoration-none" %>
              </p>
            <% end %>

            <% if devise_mapping.registerable? %>
              <p class="mb-0 fs-5" style="color: rgba(255, 255, 255, 0.96);">
                Não tem uma conta?
                <%= link_to "Registre-se", new_registration_path(resource_name), class: "fw-bold text-white text-decoration-none" %>
              </p>
            <% end %>
          </div>

          <% if devise_mapping.confirmable? || (devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email)) || devise_mapping.omniauthable? %>
            <div class="mt-3 pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.2) !important;">
              <%= render "devise/shared/links" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    </div>
  </div>
</div>
